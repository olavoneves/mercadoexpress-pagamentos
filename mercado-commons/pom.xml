<?xml version="1.0" encoding="UTF-8"?>
<!--
  Biblioteca compartilhada entre os servicos (nao e aplicacao Spring Boot,
  por isso nao veio do Initializr e nao usa o spring-boot-maven-plugin).
  Herda do mesmo spring-boot-starter-parent so para alinhar as versoes de
  Spring AMQP, Jackson e Lombok com os servicos que a consomem.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>br.com.fiap</groupId>
	<artifactId>mercado-commons</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>mercado-commons</name>
	<description>Eventos, constantes e topologia RabbitMQ compartilhados pelos servicos</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- provided: quem usa a biblioteca ja traz o spring-boot-starter-amqp -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- Jackson 3 do conversor JSON; os servicos ja o recebem do starter web -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
