# Copie para .env (o .env nao vai para o Git) e ajuste o que precisar.
# Sem .env, o docker compose usa os valores padrao (Mailpit, portas 8080-8082).

# ---------- Portas do host (troque se ja estiverem ocupadas) ----------
# MERCADO_PORT=8080
# INTEGRACAO_PORT=8081
# BANCO_PORT=8082
# POSTGRES_PORT=5434
# RABBITMQ_PORT=5672
# RABBITMQ_PAINEL_PORT=15672
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# ---------- E-mail real com Gmail (senha de app) ----------
# 1. Ative a verificacao em duas etapas na conta Google.
# 2. Gere uma senha de app em https://myaccount.google.com/apppasswords
# 3. Descomente e preencha (o remetente PRECISA ser a propria conta):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=sua.conta@gmail.com
# MAIL_PASSWORD=abcdabcdabcdabcd
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=Mercado Express <sua.conta@gmail.com>
